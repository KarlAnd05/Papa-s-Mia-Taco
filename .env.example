# Copy to .env when connecting to your own PostgreSQL server.
# The Windows preview creates its own settings in local-preview/.env.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/pmt
PORT=8080
NODE_ENV=development
# Creates the first account only. Existing accounts/passwords are preserved.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=CHOOSE_A_PASSWORD_AT_LEAST_8_CHARACTERS
